            "body": {
              "mode": "raw",
              "raw": "{\n  \"milestones\": [\n    {\n      \"milestoneNumber\": 1,\n      \"percentage\": 50.00,\n      \"amount\": 50000.00\n    },\n    {\n      \"milestoneNumber\": 2,\n      \"percentage\": 50.00,\n      \"amount\": 50000.00\n    }\n  ]\n}"
