              ]
            },
            "description": "Retrieves the full fund utilization record details by ID."
          },
          "response": []
        },
        {
          "name": "Verify Utilization (Approve/Reject)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Officer inspected invoices and confirmed hardware installation on-site\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/fund-utilizations/1/verify?status=VERIFIED",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "fund-utilizations",
                "1",
                "verify"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "VERIFIED"
                }
              ]
            },
            "description": "Officer verifies the utilization submission, updating verification status to VERIFIED or REJECTED with remarks."
          },
          "response": []
        },
        {
          "name": "Get Application Utilization Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
