          "response": []
        },
        {
          "name": "Release Milestone Payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/v1/disbursement-plans/1/milestones/2/release?financeOfficerId=1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "disbursement-plans",
                "1",
                "milestones",
                "2",
                "release"
              ],
              "query": [
                {
                  "key": "financeOfficerId",
                  "value": "1"
                }
              ]
            },
            "description": "Releases milestone funds. Restricts subsequent milestones (Milestone 2+) until the previous milestone (Milestone 1) has an approved COMPLIANT status record."
          },
          "response": []
        }
      ]
