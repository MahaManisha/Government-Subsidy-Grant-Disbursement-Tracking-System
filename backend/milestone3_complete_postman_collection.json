  "item": [
    {
      "name": "Disbursement Management",
      "item": [
        {
          "name": "Create Disbursement Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": 1,\n  \"milestones\": [\n    {\n      \"milestoneNumber\": 1,\n      \"percentage\": 40.00,\n      \"amount\": 40000.00\n    },\n    {\n      \"milestoneNumber\": 2,\n      \"percentage\": 30.00,\n      \"amount\": 30000.00\n    },\n    {\n      \"milestoneNumber\": 3,\n      \"percentage\": 30.00,\n      \"amount\": 30000.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/disbursement-plans",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "disbursement-plans"
              ]
            },
            "description": "Creates a multi-milestone disbursement plan for an approved application. Validates that the sum of percentages is 100% and amounts match approvedAmount."
          },
          "response": []
        },
        {
          "name": "Get Disbursement Plan by ID",
