    {
      "name": "Fund Utilization Tracking",
      "item": [
        {
          "name": "Submit Fund Utilization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": 1,\n  \"disbursementId\": 1,\n  \"amountUtilized\": 30000.00,\n  \"purpose\": \"Procured solar panels and micro-inverter equipment\",\n  \"supportingDocsMetadata\": \"https://supabase.co/storage/v1/object/public/proofs/solar-purchase-invoice.pdf\",\n  \"remarks\": \"Beneficiary submission for milestone 1 funds utilization\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/fund-utilizations",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "fund-utilizations"
