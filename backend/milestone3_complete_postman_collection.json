            "description": "Retrieves compliance list by Application ID."
          },
          "response": []
        },
        {
          "name": "Update Compliance Record",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"officerRemarks\": \"Site check completed. Invoices verified.\",\n  \"inspectionDate\": \"2026-07-12T10:00:00\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/compliances/1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "compliances",
                "1"
              ]
            },
            "description": "Updates non-verified compliance record details."
          },
          "response": []
        },
        {
          "name": "Approve Compliance Check",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/v1/compliances/1/approve",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "compliances",
                "1",
                "approve"
              ]
            },
            "description": "Approves compliance check. If this is the final milestone in the plan, automatically completes application pipeline, updating application status to DISBURSED. Otherwise, advances application status to READY_FOR_DISBURSEMENT."
          },
          "response": []
        },
        {
          "name": "Reject Compliance Check",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/v1/compliances/1/reject?reason=Missing proof of purchase receipts",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "compliances",
                "1",
                "reject"
              ],
              "query": [
                {
                  "key": "reason",
                  "value": "Missing proof of purchase receipts"
                }
              ]
            },
            "description": "Rejects compliance check, marking status to REJECTED."
          },
          "response": []
        }
      ]
