    {
      "name": "Protected Resources Tests",
      "item": [
        {
          "name": "Get All Users (Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/v1/users",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "Retrieves all user accounts. Restrained to ADMIN roles; will return 403 Forbidden for Beneficiary or other lower roles."
          },
          "response": []
        },
        {
          "name": "Get Regional Analytics (Admin/Finance Officer)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/v1/analytics/report",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "analytics",
                "report"
              ]
            },
            "description": "Retrieves the regional dashboard analytics. Restricted to ROLE_ADMIN and ROLE_FINANCE_OFFICER. Will return 403 Forbidden for Beneficiary, Field Officer, and District Officer roles."
          },
          "response": []
        }
      ]
